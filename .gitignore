# The public rule corpus is fetched at a pinned commit, not vendored. Vendoring
# 3,799 third party YAML files would bury this project's own code in the
# language bar and in every diff. tools/fetch_corpus.py reproduces it exactly.
.corpus/
benchmark/results/*.json
!benchmark/results/.gitkeep
